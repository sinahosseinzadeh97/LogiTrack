# Copy to .env to override the defaults in docker-compose.yml. All are optional for a local demo.

# Required for anything public. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port for the web UI on your machine
WEB_PORT=8080

# production refuses to start with the built-in dev SECRET_KEY
ENVIRONMENT=development

POSTGRES_USER=logitrack
POSTGRES_PASSWORD=logitrack
POSTGRES_DB=logitrack

# Demo accounts admin@ / analyst@ / viewer@logitrack.dev. Set SEED_DEMO_USERS=false to skip.
SEED_DEMO_USERS=true
DEMO_PASSWORD=logitrack-demo
